{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "resolveJsonModule": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "isolatedModules": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "worker", "vite.config.ts"]
}

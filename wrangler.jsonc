{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "depoisdaceia",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/privacidade/", "/api/*"]
  },
  "observability": { "enabled": true },
  // keep_vars: variáveis criadas no painel da Cloudflare (GA4, pixel, responsável) não são apagadas a cada publicação.
  "keep_vars": true,
  "vars": {
    "CHECKOUT_URL": "https://pay.cakto.com.br/azievdt_1367352",
    "CONTATO": "contato@depoisdaceia.com.br",
    "META_PIXEL_ID": "1155576360166251"
  }
  // Segredos (nunca aqui): npx wrangler secret put GA4_API_SECRET  |  npx wrangler secret put CAKTO_WEBHOOK_SECRET
  // Opcional, para não contar a mesma compra duas vezes: crie um KV e descomente:
  // "kv_namespaces": [{ "binding": "DC_KV", "id": "<id do KV>" }]
}
